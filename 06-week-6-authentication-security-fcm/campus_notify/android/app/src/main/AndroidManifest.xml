<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      ══════════════════════════════════════════════════════════════════════════
       PERMISSIONS
      ══════════════════════════════════════════════════════════════════════════

      [ANDROID 13+] POST_NOTIFICATIONS — API Level 33 (Android 13) mewajibkan
      runtime permission ini untuk menampilkan notifikasi. Pada API ≤ 32, izin
      ini diabaikan secara otomatis oleh sistem.
      FirebaseMessaging.requestPermission() + requestNotificationsPermission()
      di push_service.dart sudah menangani dialog runtime-nya.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- VIBRATE diperlukan untuk getaran notifikasi di semua versi Android -->
    <uses-permission android:name="android.permission.VIBRATE"/>

    <application
        android:label="campus_notify"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!--
          ════════════════════════════════════════════════════════════════════
           FCM DEFAULT NOTIFICATION CHANNEL  [ANDROID 8+ / API 26+]
          ════════════════════════════════════════════════════════════════════

          Nilai ini HARUS sama persis dengan _kChannelId di push_service.dart
          ('pengumuman_kampus'). FCM menggunakan channel ini untuk notifikasi
          yang dikirim dari server (data-only atau notification payload) saat
          app di background/terminated.

          Tanpa meta-data ini, FCM akan membuat channel "Miscellaneous" default
          yang mungkin tidak sesuai konfigurasi importance/sound Anda.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="pengumuman_kampus"/>

        <!--
          Ikon notifikasi default yang dipakai FCM saat app di background.
          Ganti @mipmap/ic_launcher dengan ikon monokrom khusus (res/drawable/)
          agar tampil bersih di status bar Android (putih transparan).
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher"/>

        <!--
          Warna aksen ikon notifikasi (opsional).
          Ganti dengan warna brand kampus Anda.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color"/>

    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>

